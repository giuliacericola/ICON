<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/franc/ontologies/2026/7/untitled-ontology-22"
         xmlns="http://www.semanticweb.org/franc/ontologies/2026/7/untitled-ontology-22#">

<owl:Ontology rdf:about="http://www.semanticweb.org/franc/ontologies/2026/7/untitled-ontology-22"/>

<owl:ObjectProperty rdf:about="#hasPowerSource">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#PowerSource"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUniverse">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Universe"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasWeakness">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="#PowerSource"/>
  <rdfs:range rdf:resource="#Weakness"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasVulnerability">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#hasPowerSource"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#hasWeakness"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Weakness"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasIntelligence">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasStrength">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSpeed">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPopularity">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Character"/>

<owl:Class rdf:about="#Leader">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Character"/>
        <rdf:Description rdf:about="#StrategicGenius"/>
        <rdf:Description rdf:about="#Charismatic"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#Powerhouse">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Character"/>
        <rdf:Description rdf:about="#DevastatingForce"/>
        <owl:Class>
          <owl:complementOf rdf:resource="#StrategicGenius"/>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#Specialist">
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#TacticalProfile"/>

<owl:Class rdf:about="#StrategicGenius">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasIntelligence"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#TacticalProfile"/>
</owl:Class>

<owl:Class rdf:about="#DevastatingForce">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasStrength"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#TacticalProfile"/>
</owl:Class>

<owl:Class rdf:about="#HighMobility">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSpeed"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#TacticalProfile"/>
</owl:Class>

<owl:Class rdf:about="#HeavyHitter">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasStrength"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#TacticalProfile"/>
</owl:Class>

<owl:Class rdf:about="#Reputation"/>

<owl:Class rdf:about="#Charismatic">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasPopularity"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Reputation"/>
</owl:Class>

<owl:Class rdf:about="#LowProfile">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasPopularity"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</xsd:maxInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Reputation"/>
</owl:Class>

<owl:Class rdf:about="#MediumReputation">
  <rdfs:subClassOf rdf:resource="#Reputation"/>
</owl:Class>

<owl:Class rdf:about="#Universe"/>

<owl:Class rdf:about="#DC">
  <rdfs:subClassOf rdf:resource="#Universe"/>
  <owl:disjointWith rdf:resource="#MC"/>
</owl:Class>

<owl:Class rdf:about="#MC">
  <rdfs:subClassOf rdf:resource="#Universe"/>
</owl:Class>

<owl:Class rdf:about="#PowerSource"/>

<owl:Class rdf:about="#Supernatural">
  <rdfs:subClassOf rdf:resource="#PowerSource"/>
  <owl:disjointWith rdf:resource="#TechnologicalWeapon"/>
</owl:Class>

<owl:Class rdf:about="#TechnologicalWeapon">
  <rdfs:subClassOf rdf:resource="#PowerSource"/>
</owl:Class>

<owl:Class rdf:about="#Weakness"/>

<owl:Class rdf:about="#EMP">
  <rdfs:subClassOf rdf:resource="#Weakness"/>
  <owl:disjointWith rdf:resource="#AntiMagicSeal"/>
</owl:Class>

<owl:Class rdf:about="#AntiMagicSeal">
  <rdfs:subClassOf rdf:resource="#Weakness"/>
</owl:Class>

<owl:Class rdf:about="#EMPTarget">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Character"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasVulnerability"/>
          <owl:someValuesFrom rdf:resource="#EMP"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#Supernatural_Single_Inst">
  <rdf:type rdf:resource="#Supernatural"/>
  <hasWeakness rdf:resource="#AntiMagicSeal_Single_Inst"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#TechnologicalWeapon_Single_Inst">
  <rdf:type rdf:resource="#TechnologicalWeapon"/>
  <hasWeakness rdf:resource="#EMP_Single_Inst"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EMP_Single_Inst">
  <rdf:type rdf:resource="#EMP"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AntiMagicSeal_Single_Inst">
  <rdf:type rdf:resource="#AntiMagicSeal"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Superman">
  <rdf:type rdf:resource="#Character"/>
  <hasPowerSource rdf:resource="#Supernatural_Single_Inst"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Superman</rdfs:label>
  <hasStrength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</hasStrength>
  <hasIntelligence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasIntelligence>
  <hasSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</hasSpeed>
