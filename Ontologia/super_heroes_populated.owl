<owl:NamedIndividual rdf:about="#Cyborg">
  <rdf:type rdf:resource="#Character"/>
  <hasPowerSource rdf:resource="#TechnologicalWeapon_Single_Inst"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cyborg</rdfs:label>
  <hasStrength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</hasStrength>
